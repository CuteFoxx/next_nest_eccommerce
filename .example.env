# Copy this file to .env and fill in the values.
# Single .env at the repo root is consumed by Docker Compose and by the backend ConfigService.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000               # Backend HTTP port
DEBUG_PORT=9229         # Node.js debugger port (mapped by docker compose)

# ── Database (Postgres) ───────────────────────────────────────────────────────
DB_HOST=db              # Docker Compose service name; use localhost outside Docker
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Full connection string used by Prisma (must match DB_* vars above)
DATABASE_URL="postgres://postgres:postgres@db:5432/postgres?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me_refresh"

# Token lifetimes in seconds
JWT_EXPIRES_IN_S=1800           # Access token — 30 minutes
JWT_REFRESH_EXPIRES_IN_S=72000  # Refresh token — 20 hours

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"       # Used for CORS allow-origin in main.ts
BACKEND_URL=http://backend:5000            # Next.js 
SESSION_SECRET="your_session_secret_key"   
# ── Prisma Studio ─────────────────────────────────────────────────────────────
PRISMA_STUDIO_PORT=5555
# ── File Storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local # Supported: local, remote
STORAGE_LOCAL_PATH=./uploads
STORAGE_REMOTE_PATH=
STORAGE_BASE_URL=                        # Leave empty for relative paths (proxied by Next.js); set to CDN URL in production